# Database — Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/medora?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google / Facebook OAuth (customer auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="medora"
R2_PUBLIC_URL="https://pub-example.r2.dev"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Upstash Redis (BullMQ)
REDIS_URL="rediss://default:password@example.upstash.io:6379"

# bdbulksms.com (OTP SMS)
BDBULKSMS_API_KEY=""
BDBULKSMS_SENDER_ID=""

# reCAPTCHA (OTP request gate)
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Sentry
SENTRY_DSN=""

# Seed script — bootstrap OWNER account
SEED_ORG_NAME="Medora Pharmacy"
